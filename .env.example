# Copy to .env and fill in. settings.py reads .env at start; variables already set in the
# environment win. There are no API keys here: Claude, NotebookLM and Gemini are used through
# their command-line tools, which keep their own sign-ins.

# ---- required for live research ----
# The NotebookLM notebook that holds your source documents (the id in the notebook's URL).
CRA_NOTEBOOK_ID=

# ---- external commands (defaults shown) ----
# Claude Code CLI. Default: "claude" from PATH.
# CRA_CLAUDE_CMD=claude
# NotebookLM CLI (the notebooklm-py package). Default runs it through uv.
# CRA_NOTEBOOKLM_CMD=uv run --no-project --quiet --with notebooklm-py notebooklm
# Shown when the NotebookLM sign-in is missing or expired.
# CRA_NOTEBOOKLM_LOGIN_CMD=uvx --from "notebooklm-py[browser]" notebooklm login --browser chrome
# The sign-in command the web app's Connections dialog runs.
# CRA_NOTEBOOKLM_APP_LOGIN_CMD=uv run --no-project --quiet --with "notebooklm-py[browser]" notebooklm login --browser chrome --browser-timeout 300
# Optional Gemini worker: the Antigravity CLI and its model.
# GEMINI_WORKER_AGY_CMD=agy
# GEMINI_WORKER_MODEL=gemini-3.8-flash-medium

# ---- models passed to `claude --model` (an alias or a full model id) ----
# CRA_PLANNER_MODEL=opus
# CRA_ANSWER_MODEL=opus
# CRA_QUICK_ANSWER_MODEL=opus
# CRA_COVERAGE_MODEL=haiku
# CRA_FAST_MODEL=haiku

# ---- paths (relative paths are taken from the repo root) ----
# CRA_DATA_DIR=data
# CRA_LOGS_DIR=logs
# CRA_CACHE_DIR=.cache
# The research-memory database (an absolute path, or relative to the working directory).
# CRA_MEMORY_DB=data/research-memory.db

# ---- behaviour ----
# Names community text uses for the corpus author, as a regex alternation.
# CRA_AUTHOR_NAMES=the author|author|the instructor|instructor
# Bump after changing the notebook's sources, so cached retrieval is not reused.
# CRA_CORPUS_EPOCH=0
# CRA_REUSE_MAX_AGE_HOURS=168
# Turn research memory off for a run: CRA_MEMORY=off
# Ignore reuse and the retrieval cache for a run: CRA_FRESH=1
# Web server port, and the API address the Vite dev server proxies to.
# CRA_PORT=8765
# CRA_API_URL=http://127.0.0.1:8765
# Run the live model tests (spends model usage): CRA_LIVE_EVALS=1
